<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Portable.Licensing</RootNamespace>
    <AssemblyName>Portable.Licensing</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Portable.Licensing</PackageId>
    <Title>Portable.Licensing</Title>
    <Description>Portable.Licensing is a cross platform software licensing framework which allows you to implement licensing into your application or library. It provides you all the tools to create and validate licenses for your software using the Elliptic Curve Digital Signature Algorithm (ECDSA).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Licensing License Key KeyGenerator Protection Signing Nauck</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
